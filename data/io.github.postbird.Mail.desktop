[Desktop Entry]
Name=Postbird
Comment=Read and send Gmail from your Linux desktop
Exec=postbird %u
Icon=io.github.postbird.Mail
Terminal=false
Type=Application
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;
Keywords=Gmail;Email;Mail;
StartupNotify=true
StartupWMClass=io.github.postbird.Mail
